                    "port": 8080
                  },
                  "initialDelaySeconds": 2,
                  "periodSeconds": 3
                }
              }
            ],
            "enableServiceLinks": false
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
