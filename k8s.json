{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "digital-university"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "gateway-config",
        "namespace": "digital-university"
      },
      "data": {
        "nginx.conf": "events {}\n\nhttp {\n    server {\n        listen 8080;\n\n        location ~ ^/api/students/[^/]+/schedule$ {\n            proxy_pass http://schedule:8080;\n        }\n\n        location /api/students {\n            proxy_pass http://core:8080;\n        }\n\n        location /api/teachers {\n            proxy_pass http://core:8080;\n        }\n\n        location /api/subjects {\n            proxy_pass http://core:8080;\n        }\n\n        location /api/rooms {\n            proxy_pass http://rooms:8080;\n        }\n\n        location /api/buildings {\n            proxy_pass http://buildings:8080;\n        }\n\n        location /api/lessons {\n            proxy_pass http://schedule:8080;\n        }\n\n        location /swagger {\n            proxy_pass http://core:8080;\n        }\n\n        location / {\n            return 404;\n        }\n    }\n}\n"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "gateway",
        "namespace": "digital-university"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "gateway"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "gateway"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "gateway",
                "image": "nginx:1.27-alpine",
                "imagePullPolicy": "IfNotPresent",
                "ports": [
                  {
                    "containerPort": 8080
                  }
                ],
                "readinessProbe": {
                  "tcpSocket": {
                    "port": 8080
                  },
                  "initialDelaySeconds": 2,
                  "periodSeconds": 3
                },
                "volumeMounts": [
                  {
                    "name": "config",
                    "mountPath": "/etc/nginx/nginx.conf",
                    "subPath": "nginx.conf",
                    "readOnly": true
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "config",
                "configMap": {
                  "name": "gateway-config"
                }
              }
            ],
            "enableServiceLinks": false
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "gateway",
        "namespace": "digital-university"
      },
      "spec": {
        "selector": {
          "app": "gateway"
        },
        "ports": [
          {
            "name": "port-8080",
            "port": 8080,
            "targetPort": 8080,
            "nodePort": 30804
          }
        ],
        "type": "NodePort"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "postgres-data",
        "namespace": "digital-university"
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "resources": {
          "requests": {
            "storage": "1Gi"
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "database-init",
        "namespace": "digital-university"
      },
      "data": {
        "init.sql": "CREATE EXTENSION IF NOT EXISTS btree_gist;\n\nCREATE TABLE students (\n    id uuid PRIMARY KEY DEFAULT gen_random_uuid(),\n    name text NOT NULL,\n    group_name text NOT NULL,\n    email text NOT NULL DEFAULT ''\n);\n\nCREATE TABLE teachers (\n    id uuid PRIMARY KEY DEFAULT gen_random_uuid(),\n    name text NOT NULL,\n    group_name text NOT NULL DEFAULT '',\n    email text NOT NULL DEFAULT ''\n);\n\nCREATE TABLE subjects (\n    id uuid PRIMARY KEY DEFAULT gen_random_uuid(),\n    name text NOT NULL,\n    hours integer NOT NULL CHECK (hours > 0)\n);\n\nCREATE TABLE buildings (\n    id uuid PRIMARY KEY DEFAULT gen_random_uuid(),\n    name text NOT NULL,\n    address text NOT NULL\n);\n\nCREATE TABLE rooms (\n    id uuid PRIMARY KEY DEFAULT gen_random_uuid(),\n    name text NOT NULL,\n    group_name text NOT NULL DEFAULT '',\n    email text NOT NULL DEFAULT '',\n    capacity integer NOT NULL CHECK (capacity > 0),\n    building_id uuid NOT NULL REFERENCES buildings(id)\n);\n\nCREATE TABLE bookings (\n    id uuid PRIMARY KEY,\n    room_id uuid NOT NULL REFERENCES rooms(id),\n    starts_at timestamptz NOT NULL,\n    ends_at timestamptz NOT NULL,\n    CHECK (ends_at > starts_at),\n    EXCLUDE USING gist (\n        room_id WITH =,\n        tstzrange(starts_at, ends_at, '[)') WITH &&\n    )\n);\n\nCREATE TABLE lessons (\n    id uuid PRIMARY KEY,\n    teacher_id uuid NOT NULL REFERENCES teachers(id),\n    subject_id uuid NOT NULL REFERENCES subjects(id),\n    room_id uuid NOT NULL REFERENCES rooms(id),\n    group_name text NOT NULL,\n    starts_at timestamptz NOT NULL,\n    ends_at timestamptz NOT NULL,\n    status text NOT NULL,\n    CHECK (ends_at > starts_at),\n    EXCLUDE USING gist (\n        teacher_id WITH =,\n        tstzrange(starts_at, ends_at, '[)') WITH &&\n    ),\n    EXCLUDE USING gist (\n        group_name WITH =,\n        tstzrange(starts_at, ends_at, '[)') WITH &&\n    )\n);\n\nINSERT INTO buildings (id, name, address) VALUES\n    ('55555555-5555-5555-5555-555555555551', 'Учебный корпус 1', 'Москва, ул. Образцова, 9'),\n    ('55555555-5555-5555-5555-555555555552', 'Учебный корпус 2', 'Москва, ул. Образцова, 9, строение 2');\n\nINSERT INTO students (id, name, group_name, email) VALUES\n('11111111-1111-1111-1111-111111111111','Иванов Иван','ИТ-271','ivanov@university.ru'),\n('11111111-1111-1111-1111-111111111112','Петрова Анна','ИТ-271','petrova@university.ru'),\n('11111111-1111-1111-1111-111111111113','Смирнов Алексей','ИТ-272','smirnov@university.ru');\nINSERT INTO teachers (id, name, group_name, email) VALUES\n('22222222-2222-2222-2222-222222222221','Соколов Дмитрий','','sokolov@university.ru'),\n('22222222-2222-2222-2222-222222222222','Волкова Елена','','volkova@university.ru');\nINSERT INTO rooms (id, name, group_name, email, capacity, building_id) VALUES\n('33333333-3333-3333-3333-333333333331','Кабинет 301','','',25,'55555555-5555-5555-5555-555555555551'),\n('33333333-3333-3333-3333-333333333332','Компьютерный класс 405','','',30,'55555555-5555-5555-5555-555555555552');\nINSERT INTO subjects VALUES\n('44444444-4444-4444-4444-444444444441','Проектирование корпоративных приложений',108),\n('44444444-4444-4444-4444-444444444442','Базы данных',144),\n('44444444-4444-4444-4444-444444444443','Алгоритмы и структуры данных',144),\n('44444444-4444-4444-4444-444444444444','Компьютерные сети',108),\n('44444444-4444-4444-4444-444444444445','Разработка веб-приложений',108),\n('44444444-4444-4444-4444-444444444446','Информационная безопасность',72);\n"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "postgres",
        "namespace": "digital-university"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "postgres"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "postgres"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "postgres",
                "image": "postgres:16-alpine",
                "imagePullPolicy": "IfNotPresent",
                "ports": [
                  {
                    "containerPort": 5432
                  }
                ],
                "env": [
                  {
                    "name": "POSTGRES_DB",
                    "value": "university"
                  },
                  {
                    "name": "POSTGRES_PASSWORD",
                    "value": "postgres"
                  },
                  {
                    "name": "POSTGRES_USER",
                    "value": "postgres"
                  }
                ],
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "pg_isready",
                      "-U",
                      "postgres",
                      "-d",
                      "university"
                    ]
                  },
                  "initialDelaySeconds": 3,
                  "periodSeconds": 3
                },
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/var/lib/postgresql/data"
                  },
                  {
                    "name": "init",
                    "mountPath": "/docker-entrypoint-initdb.d",
                    "readOnly": true
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "data",
                "persistentVolumeClaim": {
                  "claimName": "postgres-data"
                }
              },
              {
                "name": "init",
                "configMap": {
                  "name": "database-init"
                }
              }
            ],
            "enableServiceLinks": false
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "postgres",
        "namespace": "digital-university"
      },
      "spec": {
        "selector": {
          "app": "postgres"
        },
        "ports": [
          {
            "name": "port-5432",
            "port": 5432,
            "targetPort": 5432
          }
        ]
      }
    },
