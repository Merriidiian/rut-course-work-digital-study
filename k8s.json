          },
          "spec": {
            "containers": [
              {
                "name": "rooms",
                "image": "digital-university-rooms:local",
                "imagePullPolicy": "IfNotPresent",
                "ports": [
                  {
                    "containerPort": 8080
                  }
                ],
                "env": [
                  {
                    "name": "DATABASE_URL",
                    "value": "postgres://postgres:postgres@postgres:5432/university?sslmode=disable"
                  },
                  {
                    "name": "ENTITY",
                    "value": "rooms"
                  },
                  {
                    "name": "PORT",
                    "value": "8080"
